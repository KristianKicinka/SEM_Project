##
# Dockerfile for Android Emulator (Debian Bookworm)
# Author: Kristián Kičinka (xkicin02)
##

FROM debian:bookworm-slim

# Základné balíky a závislosti
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk curl wget unzip zip bzip2 git \
    libdrm-dev libxkbcommon-dev libgbm-dev libasound-dev \
    libnss3 libxcursor1 libpulse-dev libxshmfence-dev \
    xauth xvfb x11vnc fluxbox wmctrl libdbus-glib-1-2 aapt \
 && rm -rf /var/lib/apt/lists/*

# Premenné prostredia
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/emulator:$ANDROID_SDK_ROOT/platform-tools

# Vytvor SDK adresáre
RUN mkdir -p $ANDROID_SDK_ROOT/cmdline-tools

# Stiahni a rozbaľ command line tools
WORKDIR /tmp/android_emulator
RUN curl -o cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip && \
    unzip cmdline-tools.zip -d cmdline-tools && \
    mv cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest && \
    rm -rf cmdline-tools cmdline-tools.zip

# Inicializuj repositories.cfg
RUN mkdir -p ~/.android && touch ~/.android/repositories.cfg

# Akceptuj licencie
RUN yes | sdkmanager --sdk_root=$ANDROID_SDK_ROOT --licenses

# Debug: zoznam dostupných balíkov (voliteľné)
RUN sdkmanager --sdk_root=$ANDROID_SDK_ROOT --list || true

# Inštalácia požadovaných komponentov
RUN sdkmanager --sdk_root=$ANDROID_SDK_ROOT "platform-tools"
RUN sdkmanager --sdk_root=$ANDROID_SDK_ROOT "emulator"
RUN sdkmanager --sdk_root=$ANDROID_SDK_ROOT "platforms;android-30"
RUN sdkmanager --sdk_root=$ANDROID_SDK_ROOT "system-images;android-30;google_apis;arm64-v8a"
RUN sdkmanager --sdk_root=$ANDROID_SDK_ROOT "build-tools;30.0.3"

# Vytvor AVD
RUN echo no | avdmanager create avd \
    --name android-30-arm64-v8a \
    --package "system-images;android-30;google_apis;arm64-v8a" \
    --force

# Spúšťací skript
RUN echo '#!/bin/sh\n\
adb start-server\n\
emulator -avd android-30-arm64-v8a -no-window -gpu swiftshader_indirect -no-snapshot -noaudio -no-boot-anim -nocache -wipe-data' \
> /entry.sh && chmod +x /entry.sh

ENTRYPOINT ["/usr/bin/sh"]
CMD ["/entry.sh"]