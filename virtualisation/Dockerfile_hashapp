FROM node:21.6.2-slim as ReactHashApp

# Copy package.json
RUN mkdir -p /var/www/sem_project/
COPY ./ /var/www/sem_project/

WORKDIR /var/www/sem_project/

RUN npm install
RUN npm run build

FROM php:8.2-apache

# Set max file and post size limits
COPY ./installationFiles/custom_php_settings.ini /usr/local/etc/php/conf.d/custom_php_settings.ini

RUN apt-get update
RUN apt-get install -y curl wget build-essential autoconf automake cmake sudo aria2 redis libzip-dev

USER root

# Add apache2 to public direcotry
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Copy project directory
RUN mkdir -p /var/www/html

WORKDIR /var/www/html

COPY . /var/www/html

# Configure Laravel
RUN a2enmod rewrite

# Restart apache server
RUN service apache2 restart

# Install PHP extensions
RUN docker-php-ext-install pdo_mysql zip

# Install composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Install dependencies
RUN composer install

# Set permissions
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

# Copy built React applications
COPY --from=ReactHashApp /var/www/sem_project/public /var/www/html/public


# install Python3.11.2
RUN mkdir -p /tmp/pythonInstallation
WORKDIR /tmp/pythonInstallation
RUN apt-get install -y libncursesw5-dev libssl-dev libsqlite3-dev tk-dev libgdbm-dev libc6-dev libbz2-dev libffi-dev zlib1g-dev
RUN wget https://www.python.org/ftp/python/3.11.2/Python-3.11.2.tgz
RUN tar -xzf Python-3.11.2.tgz
WORKDIR /tmp/pythonInstallation/Python-3.11.2
RUN ./configure --enable-optimizations
RUN make -j 4
RUN make altinstall

# check python version
RUN python3.11 -V

# Install python dependencies:
RUN apt-get install -y dbus libdbus-1-3 libdbus-1-dev libcairo2-dev libgirepository1.0-dev
COPY ./installationFiles/requirements.txt /tmp/requirements.txt
RUN pip3.11 install -r /tmp/requirements.txt

# Install Wireshark 4.2.4
WORKDIR /tmp/wireshark
RUN apt-get install -y libspeexdsp-dev systemd flex qt6-* libgtk-3-dev libpcap-dev libgcrypt20-dev libgpg-error-dev qttools5-dev qttools5-dev-tools libqt5svg5-dev libtool libc-ares2 libc-ares-dev

RUN wget https://www.wireshark.org/download/src/all-versions/wireshark-4.2.4.tar.xz
RUN tar -xf wireshark-4.2.4.tar.xz

WORKDIR /tmp/wireshark/wireshark-4.2.4/

RUN mkdir build

WORKDIR /tmp/wireshark/wireshark-4.2.4/build

RUN cmake ..
RUN make
RUN make install

# check version
RUN wireshark -v

# Setup wireshark for none root users
RUN groupadd wireshark
RUN usermod -a -G wireshark www-data

# change permissions for dumpcap
RUN chgrp wireshark /usr/local/bin/dumpcap
RUN chmod 4750 /usr/local/bin/dumpcap

WORKDIR /var/www/html

# Create sotrage simlink
RUN php artisan storage:link

# migrate database
#RUN php artisan migrate

# seed data to database
#CMD php artisan db:seed --class=UserSeeder
#CMD php artisan db:seed --class=EmulatorSeeder

# load data to database
#RUN /etc/init.d/mariadb start
#RUN mysql -u root -p root sem_project < ./installationFiles/sem_project_db_data.sql

#Create file structure
RUN mkdir -p storage/app/public/pcaps

RUN mkdir -p storage/app/public/uploads/apk_inserted
RUN mkdir -p storage/app/public/uploads/apk_downloaded
RUN mkdir -p storage/app/public/uploads/text_inserted
RUN mkdir -p storage/app/public/uploads/pcap_inserted

RUN mkdir -p storage/logs
RUN touch storage/logs/default_worker.log

#EXPOSE 8080

# Install supervisor
RUN apt update && sudo apt install supervisor
COPY ./installationFiles/laravel_workers_queue.conf /etc/supervisor/conf.d/laravel_workers_queue.conf

#Start supervisor
CMD supervisord -c /etc/supervisor/supervisord.conf

