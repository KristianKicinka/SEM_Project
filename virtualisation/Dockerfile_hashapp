#########################
# 1) FRONTEND (React)   #
#########################
FROM node:22-slim AS reacthashapp

# Pracovný adresár a práva
USER root
RUN mkdir -p /var/www/sem_project && chown -R www-data:www-data /var/www
USER www-data
WORKDIR /var/www/sem_project

# Najprv len manifesty (lepšie cache) + správne vlastníctvo
COPY --chown=www-data:www-data package*.json ./

# Repro inštalácia (ci ak existuje lock)
RUN if [ -f ./package-lock.json ]; then npm ci; else npm install; fi

# Zvyšok zdrojákov s korektným vlastníctvom
COPY --chown=www-data:www-data . .

# Build
RUN npm run build


#########################
# 2) WEB (PHP/Apache)   #
#########################
FROM sem_python_wireshark_php8.2:latest

USER root

# Vlastné PHP nastavenia
COPY ./virtualisation/installationFiles/custom_php_settings.ini /usr/local/etc/php/conf.d/custom_php_settings.ini

# Apache DocumentRoot do /public a vlastný port
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public \
    APACHE_HTTP_PORT=8081

# Apache & PHP extensions & prepísanie configov
RUN set -eux; \
    a2enmod rewrite; \
    docker-php-ext-install pdo_mysql zip; \
    sed -ri -e "s!/var/www/html!${APACHE_DOCUMENT_ROOT}!g" /etc/apache2/sites-available/*.conf; \
    sed -ri -e "s!/var/www/!${APACHE_DOCUMENT_ROOT}!g" /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf; \
    sed -i "s/Listen 80/Listen ${APACHE_HTTP_PORT}/" /etc/apache2/ports.conf; \
    sed -i "s#<VirtualHost \*:80>#<VirtualHost *:${APACHE_HTTP_PORT}>#" /etc/apache2/sites-available/000-default.conf

# Systémové balíčky (jeden layer, bez recommendov)
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget aria2 \
      build-essential autoconf automake cmake \
      sudo libzip-dev \
      vim iproute2 net-tools iputils-ping mariadb-client \
      supervisor; \
    rm -rf /var/lib/apt/lists/*

##########
# Docker #
##########
# UPOZORNENIE: na runtime pripoj /var/run/docker.sock z hosta, inak docker CLI nebude fungovať.
ARG DOCKER_GROUP_ID

RUN set -eux; \
    install -m 0755 -d /etc/apt/keyrings; \
    curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc; \
    chmod a+r /etc/apt/keyrings/docker.asc; \
    . /etc/os-release; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian ${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; \
    rm -rf /var/lib/apt/lists/*; \
    # Ak je DOCKER_GROUP_ID zadané, zosúladíme GID skupiny 'docker' s hostom
    if [ -n "${DOCKER_GROUP_ID:-}" ]; then groupmod -o -g "${DOCKER_GROUP_ID}" docker || true; fi; \
    # Potom pridáme www-data do skupiny docker
    usermod -aG docker www-data

# Projekt (Laravel + buildnutý frontend)
RUN mkdir -p /var/www/html
COPY . /var/www/html
WORKDIR /var/www/html

# Práva pre Laravel dirs
RUN chown -R www-data:www-data /var/www && \
    chmod -R 0776 /var/www/html/storage /var/www/html/bootstrap/cache

# Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

USER www-data
RUN composer install --no-interaction --prefer-dist

# Skopíruj buildnutý React do public
COPY --from=reacthashapp /var/www/sem_project/public /var/www/html/public

# Laravel: symlink na storage a adresárová štruktúra
RUN php artisan storage:link && \
    mkdir -p storage/app/public/pcaps \
             storage/app/public/tmp_xapk \
             storage/app/public/uploads/apk_inserted \
             storage/app/public/uploads/apk_downloaded \
             storage/app/public/uploads/text_inserted \
             storage/app/public/uploads/pcap_inserted && \
    mkdir -p storage/logs && \
    touch storage/logs/default_worker.log

USER root
# Práva na public storage (ak vznikli nové súbory)
RUN chown -R www-data:www-data /var/www/html/storage/app/public && \
    chmod -R 0776 /var/www/html/storage/app/public

# Supervisor config
COPY ./virtualisation/installationFiles/laravel_workers_queue.conf /etc/supervisor/conf.d/laravel_workers_queue.conf

############
# Entrypoint
############
RUN cat > /usr/local/bin/entrypoint.sh <<'EOF' && chmod +x /usr/local/bin/entrypoint.sh
#!/usr/bin/env bash
set -euo pipefail

if [ -S /var/run/docker.sock ]; then
  chown root:docker /var/run/docker.sock || true
fi

service supervisor start
exec apache2-foreground
EOF

USER root
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
