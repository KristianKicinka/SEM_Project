FROM php:8.3-apache

USER root

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHON_VERSION=3.11.9
# pkg-config cesty a flagy pre PyGObject
ENV PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu
ENV CFLAGS="-I/usr/include/gobject-introspection-1.0"
ENV LDFLAGS="-L/usr/lib/x86_64-linux-gnu"
# pycurl má ísť cez OpenSSL
ENV PYCURL_SSL_LIBRARY=openssl
# pip bez cache
ENV PIP_NO_CACHE_DIR=1

# ==== 1) Systémové nástroje + dev závislosti pre tvoje requirements ====
RUN apt-get update && apt-get install -y \
  curl wget ca-certificates tzdata git \
  build-essential autoconf automake cmake sudo aria2 redis libzip-dev \
  # python build závislosti
  libncursesw5-dev libssl-dev libsqlite3-dev tk-dev libgdbm-dev libc6-dev libbz2-dev libffi-dev zlib1g-dev \
  # tooly
  pkg-config meson ninja-build \
  # PyGObject / pycairo + introspection
  libglib2.0-dev libgirepository-2.0-0 libgirepository-2.0-dev gobject-introspection \
  gir1.2-glib-2.0 gir1.2-girepository-2.0 libcairo2-dev \
  # lxml
  libxml2-dev libxslt1-dev \
  # Pillow / matplotlib
  libjpeg-dev libfreetype6-dev libpng-dev \
  # numpy/scipy
  libopenblas-dev liblapack-dev gfortran \
  # pycurl
  libcurl4-openssl-dev \
  # dbus runtime a headers
  dbus libdbus-1-3 libdbus-1-dev \
  && rm -rf /var/lib/apt/lists/*

# ==== 2) Kompilácia Python 3.11.9 zo zdrojov ====
RUN mkdir -p /tmp/pythonInstallation && cd /tmp/pythonInstallation \
  && wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz \
  && tar -xzf Python-${PYTHON_VERSION}.tgz \
  && cd Python-${PYTHON_VERSION} \
  && ./configure --enable-optimizations \
  && make -j$(nproc) \
  && make altinstall \
  && python3.11 -m ensurepip \
  && ln -s /usr/local/bin/pip3.11 /usr/bin/pip3.11 || true \
  && cd / && rm -rf /tmp/pythonInstallation

# ==== 3) Príprava pip/build backendov ====
RUN python3.11 -m pip install --upgrade pip setuptools wheel \
  && python3.11 -m pip install --upgrade meson meson-python

RUN pip3.11 install --no-build-isolation pycairo

# ==== 4) Requirements (tvoje) ====
COPY ./installationFiles/requirements.txt /tmp/requirements.txt

# Rýchla kontrola, že pkg-config vidí girepository-2.0 (debug-friendly)
RUN pkg-config --modversion girepository-2.0 && pkg-config --cflags --libs girepository-2.0

# Inštalácia Python balíkov
RUN pip3.11 install --no-build-isolation --config-settings=setup-args="-Dtests=false" -r /tmp/requirements.txt

# ==== 5) Inštalácia Wireshark 4.2.4 s GUI (Qt6) zo zdrojov ====
WORKDIR /tmp/wireshark

RUN apt-get update && apt-get install -y \
    # core deps
    libspeexdsp-dev systemd flex \
    libpcap-dev libgcrypt20-dev libgpg-error-dev \
    libtool libc-ares2 libc-ares-dev gettext libssh-dev \
    # Qt6 GUI + doplnky
    qt6-base-dev qt6-tools-dev qt6-tools-dev-tools libqt6svg6-dev \
    qt6-5compat-dev \
    # XKB (klávesnica) a CUPS (tlač)
    libxkbcommon-dev libcups2-dev \
    # (voliteľné, ale pomáha pri runtime Qt/X11)
    libxkbcommon-x11-0 libxcb-xkb1 \
 && wget https://www.wireshark.org/download/src/all-versions/wireshark-4.2.4.tar.xz \
 && tar -xf wireshark-4.2.4.tar.xz \
 && cd wireshark-4.2.4 \
 && mkdir build && cd build \
 && cmake .. \
      -DENABLE_QT=ON \
      -DBUILD_wireshark=ON \
      -DBUILD_tshark=ON \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
 && make -j"$(nproc)" && make install \
 && ldconfig \
 && cd / && rm -rf /tmp/wireshark \
 && rm -rf /var/lib/apt/lists/*

# ==== 6) Overenie verzií ====
RUN python3.11 --version \
 && pip3.11 --version \
 && wireshark -v \
 && tshark -v \
 && dumpcap -v

# ==== 7) Nastavenie Wireshark pre non-root ====
RUN groupadd wireshark \
  && usermod -a -G wireshark www-data \
  && chgrp wireshark /usr/local/bin/dumpcap \
  && chmod 4750 /usr/local/bin/dumpcap
